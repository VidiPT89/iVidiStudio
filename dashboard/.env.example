# Login do painel (HTTP Basic). Em produção, sem isto o painel responde 503; em dev fica aberto.
DASHBOARD_USER=vidi
DASHBOARD_PASSWORD=

# Webhook do Client Portal → ticket em elevador/entrada/ (POST /api/portal)
# Segredo partilhado com o portal; o portal assina o corpo com HMAC-SHA256 no header x-ividi-signature: sha256=<hex>
PORTAL_WEBHOOK_SECRET=
# Token GitHub com permissão contents:write só neste repositório (fine-grained)
GITHUB_TOKEN=
# Repositório onde vive o edifício
GITHUB_REPO=VidiPT89/iVidiStudio
